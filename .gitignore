# Unreal Engine .gitignore
# Patterns use **/ so they work when each Unreal project
# lives in its own subfolder of the repo (or at the root).

# ---------- Unreal generated folders ----------
**/Binaries/
**/Intermediate/
**/Saved/
**/DerivedDataCache/
**/Build/
**/Plugins/**/Binaries/
**/Plugins/**/Intermediate/

# Built lighting data (rebuilt locally, big and noisy in diffs)
*_BuiltData.uasset

# ---------- IDE / project files (regenerated by the engine) ----------
.vs/
.vscode/
.idea/
*.sln
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.code-workspace
*.xcodeproj
*.xcworkspace
.vsconfig

# ---------- Compiled output (C++ projects) ----------
*.obj
*.o
*.pch
*.gch
*.pdb
*.ilk
*.exp
*.lib
*.a
*.dll
*.so
*.dylib
*.exe
*.app

# ---------- OS junk ----------
.DS_Store
Thumbs.db
Desktop.ini
